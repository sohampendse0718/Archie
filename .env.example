# ──────────────────────────────────────────────────────
# ARCHIE — Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# On Vercel, add these in: Project Settings → Environment Variables
# ──────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────
# Found at: https://supabase.com/dashboard → Your Project → Settings → API

# Your project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — SECRET, never expose in browser!
# Required for the Delete Account API route (/api/auth/delete-account)
# Found at: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google Gemini AI (required) ──────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here
